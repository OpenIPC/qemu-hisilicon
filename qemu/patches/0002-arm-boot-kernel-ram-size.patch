arm/boot: place the initrd by the kernel's RAM, report the board's

arm_boot_info.ram_size does two jobs: it is the RAM the guest is told
about (ATAG_MEM, or the DT memory node QEMU generates), and it bounds
where the initrd and DTB go.  A HiSilicon/Goke camera boots with
mem=<Linux share> on the command line and the rest of the DDR left to
MMZ, and its bootloader reports the whole DDR.  The firmware relies on
that: OpenIPC's load_hisilicon reads total RAM from the memory node and
carves MMZ from the part above mem=.

With one field, the board had to choose.  Reporting the whole DDR put the
initrd at ram_size/2, outside a mem=32M kernel ("INITRD ... is not a
memory region").  Reporting the kernel's share told the firmware the
camera had 32M in all, so it computed os_mem == total_mem and loaded no
modules.

kernel_ram_size, when set, bounds the initrd and DTB placement only;
ram_size goes to the guest unchanged.  Zero keeps the old behaviour for
every board that does not set it.

diff --git a/hw/arm/boot.c b/hw/arm/boot.c
index b916602..67de58c 100644
--- a/hw/arm/boot.c
+++ b/hw/arm/boot.c
@@ -909,6 +909,8 @@ static void arm_setup_direct_kernel_boot(ARMCPU *cpu,
     hwaddr entry;
     static const ARMInsnFixup *primary_loader;
     uint64_t ram_end = info->loader_start + info->ram_size;
+    uint64_t kernel_ram_size = info->kernel_ram_size ?: info->ram_size;
+    uint64_t kernel_ram_end = info->loader_start + kernel_ram_size;
 
     if (arm_feature(&cpu->env, ARM_FEATURE_AARCH64)) {
         primary_loader = bootloader_aarch64;
@@ -1002,7 +1004,7 @@ static void arm_setup_direct_kernel_boot(ARMCPU *cpu,
      * we might still make a bad choice here.
      */
     info->initrd_start = info->loader_start +
-        MIN(info->ram_size / 2, 128 * MiB);
+        MIN(kernel_ram_size / 2, 128 * MiB);
     if (image_high_addr) {
         info->initrd_start = MAX(info->initrd_start, image_high_addr);
     }
@@ -1013,18 +1015,18 @@ static void arm_setup_direct_kernel_boot(ARMCPU *cpu,
 
         if (info->initrd_filename) {
 
-            if (info->initrd_start >= ram_end) {
+            if (info->initrd_start >= kernel_ram_end) {
                 error_report("not enough space after kernel to load initrd");
                 exit(1);
             }
 
             initrd_size = load_ramdisk_as(info->initrd_filename,
                                           info->initrd_start,
-                                          ram_end - info->initrd_start, as);
+                                          kernel_ram_end - info->initrd_start, as);
             if (initrd_size < 0) {
                 initrd_size = load_image_targphys_as(info->initrd_filename,
                                                      info->initrd_start,
-                                                     ram_end -
+                                                     kernel_ram_end -
                                                      info->initrd_start,
                                                      as, NULL);
             }
@@ -1033,7 +1035,7 @@ static void arm_setup_direct_kernel_boot(ARMCPU *cpu,
                              info->initrd_filename);
                 exit(1);
             }
-            if (info->initrd_start + initrd_size > ram_end) {
+            if (info->initrd_start + initrd_size > kernel_ram_end) {
                 error_report("could not load initrd '%s': "
                              "too big to fit into RAM after the kernel",
                              info->initrd_filename);
@@ -1074,7 +1076,7 @@ static void arm_setup_direct_kernel_boot(ARMCPU *cpu,
             /* Place the DTB after the initrd in memory with alignment. */
             info->dtb_start = QEMU_ALIGN_UP(info->initrd_start + initrd_size,
                                            align);
-            if (info->dtb_start >= ram_end) {
+            if (info->dtb_start >= kernel_ram_end) {
                 error_report("Not enough space for DTB after kernel/initrd");
                 exit(1);
             }
diff --git a/include/hw/arm/boot.h b/include/hw/arm/boot.h
index a2e22bd..142c4cf 100644
--- a/include/hw/arm/boot.h
+++ b/include/hw/arm/boot.h
@@ -39,6 +39,14 @@ void armv7m_load_kernel(ARMCPU *cpu, const char *kernel_filename,
 /* arm_boot.c */
 struct arm_boot_info {
     uint64_t ram_size;
+    /*
+     * RAM the kernel will actually use, when its command line limits it
+     * (mem=) below ram_size.  Zero means all of ram_size.  It only places
+     * the initrd and DTB, which must sit inside the kernel's memory;
+     * ram_size still goes to the guest (ATAG_MEM, DT memory node) as the
+     * whole DDR, as a real bootloader reports it.
+     */
+    uint64_t kernel_ram_size;
     const char *kernel_filename;
     const char *kernel_cmdline;
     const char *initrd_filename;
